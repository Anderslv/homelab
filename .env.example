# ── media · services/media.yml · profiles: apps dev prod ────────────────────
# TODO: describe
# (default none · setting · flaresolverr)
CAPTCHA_SOLVER=
# Set this to true in development with placeholder VPN credentials so the media routes stay up.
# Leave it unset (false) with real VPN credentials so Gluetun's health check gates the stack.
# (default false · setting · gluetun)
GLUETUN_HEALTHCHECK_DISABLED=
# TODO: describe
# (default none · setting · flaresolverr)
LOG_FILE=
# TODO: describe
# (default false · setting · flaresolverr)
LOG_HTML=
# TODO: describe
# (default info · setting · flaresolverr)
LOG_LEVEL=
# Media VPN (setup-dev.sh writes dummy local values for compose config rendering;
# replace them before running Gluetun + ProtonVPN download automation).
# (required · secret · gluetun)
OPENVPN_PASSWORD=
# Media VPN (setup-dev.sh writes dummy local values for compose config rendering;
# replace them before running Gluetun + ProtonVPN download automation).
# (required · setting · gluetun)
OPENVPN_USER=
# TODO: describe
# (default on · setting · gluetun)
VPN_FREE_ONLY=
# Media VPN server countries.
# (default Netherlands · setting · gluetun)
VPN_SERVER_COUNTRIES=

# ── hermes · services/hermes.yml · profiles: apps dev prod ──────────────────
# Hermes dashboard, reachable only over NetBird/VPN route.
# (required · secret · hermes)
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Hermes dashboard, reachable only over NetBird/VPN route.
# (required · secret · hermes)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Hermes dashboard, reachable only over NetBird/VPN route.
# (default admin · setting · hermes)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=

# ── dockhand · docker-compose.pods.yml ──────────────────────────────────────
# Dockhand bootstrap data directory on the Docker host.
# Keep the default matching path when deploying stacks with relative bind mounts.
# (default /opt/dockhand · setting · dockhand)
DOCKHAND_DATA_DIR=
