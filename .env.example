PAPERLESS_DBNAME=
# Password generator in the dev shell: mkpasswd -l 32 -s 1
# (required · secret · paperless-consumer paperless-postgres paperless-web)
PAPERLESS_DBPASS=
# Optional: App database overrides (safe defaults are in compose).
# (default paperless · setting · paperless-consumer paperless-postgres paperless-web)
PAPERLESS_DBUSER=
