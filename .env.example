# Every variable the compose files use, generated by scripts/secrets/map.sh.
# Edit only the description lines above a variable. Never put values here.

# ── core · used across the project ──────────────────────────────────────────
# Container timezone used across compose stacks.
# (default UTC · setting · 20 services)
TZ=
# Local routing defaults. Services are available as https://<service>.localhost.me.
# setup-dev.sh creates the mkcert-backed certificate files used by Traefik.
# Production HTTPS override example: lab.example.com
# (default localhost.me · setting · 34 services)
DOMAIN=
# Production HTTPS override example: you@example.com
# (optional · setting · prod-check traefik)
ACME_EMAIL=
# TODO: describe
# (default 1000 · setting · 6 services)
PGID=
# TODO: describe
# (default 1000 · setting · 6 services)
PUID=

# ── networking · services/networking.yml · profiles: dev infra prod ─────────
# Host port used for AdGuard DNS. Keep 1053 in development to avoid conflicts
# with system DNS on port 53. Set to 53 on dedicated hosts.
# (default 1053 · setting · adguard)
ADGUARD_DNS_PORT=
# Production HTTPS: a Cloudflare token with Zone Read and DNS Edit.
# (optional · secret · prod-check traefik)
CF_DNS_API_TOKEN=
# TODO: describe
# (default 192.168.1.0/24 · setting · netalertx)
NETALERTX_SCAN_SUBNETS=

# ── rustfs · services/rustfs.yml · profiles: dev infra prod ─────────────────
# RustFS
# (required · secret · rustfs)
RUSTFS_ACCESS_KEY=
# RustFS
# (required · secret · rustfs)
RUSTFS_SECRET_KEY=

# ── speedtest-tracker · services/speedtest-tracker.yml · profiles: apps dev prod ──
# Create this token in Speedtest Tracker at /admin/api-tokens with Read Results
# and Run Speedtest abilities.
# (optional · secret · speedtest-trigger)
SPEEDTEST_API_TOKEN=
# Speedtest Tracker (or export via .envrc).
# App key generator: openssl rand -base64 32
# (required · secret · speedtest-tracker)
SPEEDTEST_APP_KEY=
# Wake/queue cadence for the trigger sidecar in seconds (default: 3600).
# (default 3600 · setting · speedtest-trigger)
SPEEDTEST_TRIGGER_INTERVAL_SECONDS=

# ── listmonk · services/listmonk.yml · profiles: apps dev prod tunnel ───────
# TODO: describe
# (default "CHANGEME!" · secret · cftunnel)
CF_TUNNEL_TOKEN=
# Optional: App database overrides (safe defaults are in compose).
# (default listmonk · setting · listmonk-postgres)
LISTMONK_db__database=
# Password generator in the dev shell: mkpasswd -l 32 -s 1
# (required · secret · listmonk listmonk-postgres)
LISTMONK_db__password=
# Optional: App database overrides (safe defaults are in compose).
# (default listmonk · setting · listmonk-postgres)
LISTMONK_db__user=

# ── karakeep · services/karakeep.yml · profiles: apps dev prod ──────────────
# Leave these unset in local development to keep Karakeep password auth enabled.
# Set these in production only when you want optional OIDC sign-in.
# (optional · setting · keep)
KARAKEEP_OAUTH_CLIENT_ID=
# Leave these unset in local development to keep Karakeep password auth enabled.
# Set these in production only when you want optional OIDC sign-in.
# (optional · secret · keep)
KARAKEEP_OAUTH_CLIENT_SECRET=
# Leave these unset in local development to keep Karakeep password auth enabled.
# Set these in production only when you want optional OIDC sign-in.
# (default OIDC · setting · keep)
KARAKEEP_OAUTH_PROVIDER_NAME=
# Leave these unset in local development to keep Karakeep password auth enabled.
# Set these in production only when you want optional OIDC sign-in.
# Example: https://idp.example.com/.well-known/openid-configuration
# (optional · setting · keep)
KARAKEEP_OAUTH_WELLKNOWN_URL=
# TODO: describe
# (optional · secret · keep)
KARAKEEP_OPENAI_API_KEY=
# Generate a key using `openssl rand -hex 32 2>/dev/null`
# (required · secret · keep meilisearch)
MEILI_MASTER_KEY=
# Generate a key using `openssl rand -hex 32 2>/dev/null`
# (required · secret · keep)
NEXTAUTH_SECRET=

